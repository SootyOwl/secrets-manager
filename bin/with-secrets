#!/bin/sh
# Run PROGRAM with the keyring secrets linked to it exported as environment
# variables. Links live in secret-links.conf as lines of: program VARIABLE secret-name
[ $# -ge 1 ] || { echo "usage: with-secrets PROGRAM [ARGS...]" >&2; exit 2; }
conf=${XDG_CONFIG_HOME:-$HOME/.config}/secret-links.conf

if [ -f "$conf" ]; then
    while read -r prog var name; do
        [ "$prog" = "$1" ] || continue
        if ! value=$(secret-tool lookup service "$name"); then
            echo "with-secrets: can't read secret '$name' for $var" >&2
            exit 1
        fi
        export "$var=$value"
    done <"$conf"
fi

# exec finds the real program on PATH, not the shell function that called us.
exec "$@"
