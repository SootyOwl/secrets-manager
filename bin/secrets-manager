#!/bin/sh
# Launch the Secrets app. It needs the host's PySide6 and Kirigami, so leave a
# distrobox first.
self=$(readlink -f "$0")
if [ -e /run/.containerenv ] && command -v distrobox-host-exec >/dev/null 2>&1; then
    exec distrobox-host-exec "$self" "$@"
fi
exec python3 "$(dirname "$self")/../secrets_manager.py" "$@"
